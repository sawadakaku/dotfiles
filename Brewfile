# Homebrew packages. Install with `brew bundle --file=Brewfile`.
# Language runtimes are managed elsewhere: mise (Node/Java/Ruby/Scala/sbt/Bazelisk), uv (Python), rustup (Rust).
# Add a package here once you decide to keep it: `brew bundle add <name> --file=Brewfile`.
# Machine-specific or private packages go in ~/.Brewfile.local.

# Language toolchains
brew "go"
brew "mise"

# Shell
brew "bash"                     # bash 5 for scripts (macOS ships 3.2)
brew "pure"                     # prompt
brew "zsh-autosuggestions"
brew "zsh-completions"
brew "zsh-syntax-highlighting"

# CLI
brew "bat"
brew "eza"
brew "fzf"
brew "gh"
brew "jq"
brew "lazygit"
brew "neovim"
brew "ripgrep"
brew "zoxide"

# Containers
brew "colima"
brew "docker"                   # docker CLI (colima provides the runtime)

# Apps
cask "wezterm"
